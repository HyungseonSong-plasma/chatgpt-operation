{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact staging specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "destination", "producer", "location_evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
        "source": {"type": "string", "minLength": 1},
        "destination": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "location_evidence": {"type": "string", "minLength": 1},
        "source_type": {"const": "file", "default": "file"},
        "symlink_policy": {"enum": ["reject", "materialize"], "default": "reject"},
        "overwrite": {"type": "boolean", "default": false},
        "expected_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  }
}
