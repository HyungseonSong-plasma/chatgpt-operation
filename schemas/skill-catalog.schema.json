{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatgpt-operation.local/schemas/skill-catalog.schema.json",
  "title": "Paul central skill catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": {"const": 1},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "load_on", "activation"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {
            "type": "string",
            "pattern": "^skills/[^/]+/README\\.md$"
          },
          "load_on": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "activation": {
            "enum": ["init", "trigger", "init_or_trigger"]
          }
        }
      }
    }
  }
}
