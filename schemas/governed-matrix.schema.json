{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed matrix manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue", "sequence", "title", "prepare_manifest", "bundle_paths", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "issue": {"type": "integer", "minimum": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "prepare_manifest": {"type": "string", "pattern": "^automation/manifests/experiments/.+\\.json$"},
    "bundle_paths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "max_parallel": {"type": "integer", "minimum": 1, "maximum": 8, "default": 4},
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"$ref": "#/$defs/runSpec"}
    },
    "aggregate": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/aggregateSpec"}]
    }
  },
  "$defs": {
    "runSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "command"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
        "name": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"type": "string", "default": "."},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200, "default": 900},
        "artifacts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "aggregateSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "command"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"type": "string", "default": "."},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200, "default": 900},
        "artifacts": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
